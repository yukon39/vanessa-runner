// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&ПараметрИнструмента(Имя = "TESTSPATH", Описание = "Путь к каталогу или файлу с тестами, или к встроенным тестам (с --config-tests)")
Перем ПутьКТестам;

&ПараметрИнструмента(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
Перем РабочийКаталогПроекта;

&ПараметрИнструмента(Имя = "pathxunit", Описание = "Путь к внешней обработке xddTestRunner.epf (по умолчанию из vanessa-add)")
Перем ПутьКИнструментам;

&ПараметрИнструмента(Имя = "reportsxunit", Описание = "Параметры формирования отчетов: ФорматВывода{Путь};ФорматВывода{Путь}")
Перем ПараметрыОтчетов;

&ПараметрИнструмента(Имя = "reportxunit", Описание = "Путь к каталогу с отчетом jUnit (устарел, используйте --reportsxunit)")
Перем ВыходнойКаталогОтчета;

&ПараметрИнструмента(Имя = "xddExitCodePath", Описание = "Путь к файлу статуса тестирования (0=пройдены, 1=не пройдены)")
Перем ПутьФайлаСтатуса;

&ПараметрИнструмента(Имя = "xddConfig", Описание = "Путь к конфигурационному файлу xUnitFor1c")
Перем ПутьККонфигу;

&ПараметрИнструмента(Имя = "testclient", Описание = "Параметры тест-клиента: Пользователь:Пароль:Порт")
Перем ОпцияТестКлиент;

&ПараметрИнструмента(Имя = "testclient-additional", Описание = "Дополнительные параметры запуска тест-клиента")
Перем ДопПараметрыТестКлиента;

&ПараметрИнструмента(Имя = "config-tests", Описание = "Загружать тесты, встроенные в конфигурацию", Тип = "boolean")
Перем ЗагружатьВстроенныеТесты;

&ПараметрИнструмента(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия", Тип = "boolean")
Перем НеОжидать;

&ПараметрИнструмента(Имя = "xdddebug", Описание = "Выводить отладочные сообщения при прогоне тестов", Тип = "boolean")
Перем ВключенаОтладка;

&ПараметрИнструмента(Имя = "no-shutdown", Описание = "Не завершать 1С:Предприятие после выполнения тестов", Тип = "boolean")
Перем НеЗавершать;

&ПараметрИнструмента(Имя = "clear-reports", Описание = "Очищать каталоги отчетов перед запуском тестов", Тип = "boolean")
Перем ОчищатьОтчеты;

&Инструмент(Имя = "test-xunit", Описание = "Запустить тестирование xUnit")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаTestXunit();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Запустить тестирование xUnit завершён";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисПлатформы", СервисПлатформы);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);
	Рефлектор.УстановитьСвойство(Команда, "СервисОкружения", СервисОкружения);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииЗапуска", КонтекстMCP.НаборОпцийЗапуска());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если ПутьКТестам <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКТестам", ПутьКТестам);
	КонецЕсли;

	Если РабочийКаталогПроекта <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "РабочийКаталогПроекта", РабочийКаталогПроекта);
	КонецЕсли;

	Если ПутьКИнструментам <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКИнструментам", ПутьКИнструментам);
	КонецЕсли;

	Если ПараметрыОтчетов <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПараметрыОтчетов", ПараметрыОтчетов);
	КонецЕсли;

	Если ВыходнойКаталогОтчета <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ВыходнойКаталогОтчета", ВыходнойКаталогОтчета);
	КонецЕсли;

	Если ПутьФайлаСтатуса <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьФайлаСтатуса", ПутьФайлаСтатуса);
	КонецЕсли;

	Если ПутьККонфигу <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьККонфигу", ПутьККонфигу);
	КонецЕсли;

	Если ОпцияТестКлиент <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ОпцияТестКлиент", ОпцияТестКлиент);
	КонецЕсли;

	Если ДопПараметрыТестКлиента <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ДопПараметрыТестКлиента", ДопПараметрыТестКлиента);
	КонецЕсли;

	Если ЗагружатьВстроенныеТесты <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ЗагружатьВстроенныеТесты", ЗагружатьВстроенныеТесты);
	КонецЕсли;

	Если НеОжидать <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "НеОжидать", НеОжидать);
	КонецЕсли;

	Если ВключенаОтладка <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ВключенаОтладка", ВключенаОтладка);
	КонецЕсли;

	Если НеЗавершать <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "НеЗавершать", НеЗавершать);
	КонецЕсли;

	Если ОчищатьОтчеты <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ОчищатьОтчеты", ОчищатьОтчеты);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
