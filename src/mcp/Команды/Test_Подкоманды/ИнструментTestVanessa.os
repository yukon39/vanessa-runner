// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&ПараметрИнструмента(Имя = "feature-path", Описание = "Путь к каталогу с фичами или к конкретной фиче")
Перем ПутьКФичам;

&ПараметрИнструмента(Имя = "bddrunner-path", Описание = "Путь к внешней обработке bddRunner.epf (по умолчанию из vanessa-add)")
Перем ПутьКИнструментам;

&ПараметрИнструмента(Имя = "vanessasettings", Описание = "Путь к файлу настроек фреймворка тестирования")
Перем ПутьКНастройкам;

&ПараметрИнструмента(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
Перем РабочийКаталогПроекта;

&ПараметрИнструмента(Имя = "tags-ignore", Описание = "Теги игнорирования фича-файлов")
Перем ТегиИгнорирования;

&ПараметрИнструмента(Имя = "tags-filter", Описание = "Теги фильтрации фича-файлов")
Перем ТегиФильтр;

&ПараметрИнструмента(Имя = "additional-keys", Описание = "Дополнительные параметры, передаваемые в /C")
Перем ДопКлючи;

&ПараметрИнструмента(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия", Тип = "boolean")
Перем НеОжидать;

&Инструмент(Имя = "test-vanessa", Описание = "Запустить тестирование Vanessa")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаTestVanessa();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Запустить тестирование Vanessa завершён";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисПлатформы", СервисПлатформы);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);
	Рефлектор.УстановитьСвойство(Команда, "СервисОкружения", СервисОкружения);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииЗапуска", КонтекстMCP.НаборОпцийЗапуска());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если ПутьКФичам <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКФичам", ПутьКФичам);
	КонецЕсли;

	Если ПутьКИнструментам <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКИнструментам", ПутьКИнструментам);
	КонецЕсли;

	Если ПутьКНастройкам <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКНастройкам", ПутьКНастройкам);
	КонецЕсли;

	Если РабочийКаталогПроекта <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "РабочийКаталогПроекта", РабочийКаталогПроекта);
	КонецЕсли;

	Если ТегиИгнорирования <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ТегиИгнорирования", ТегиИгнорирования);
	КонецЕсли;

	Если ТегиФильтр <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ТегиФильтр", ТегиФильтр);
	КонецЕсли;

	Если ДопКлючи <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ДопКлючи", ДопКлючи);
	КонецЕсли;

	Если НеОжидать <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "НеОжидать", НеОжидать);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
