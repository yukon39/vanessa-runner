// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&ПараметрИнструмента(Имя = "mode", Описание = "Режимы проверки. Например: ThinClient Server WebClient.
|Доступные режимы:
|  ConfigLogIntegrity            - проверка логической целостности конфигурации
|  IncorrectReferences           - поиск некорректных ссылок
|  ThinClient                    - тонкий клиент
|  WebClient                     - веб-клиент
|  Server                        - сервер
|  ExternalConnection            - внешнее соединение
|  ExternalConnectionServer      - внешнее соединение (клиент-серверный)
|  MobileClient                  - мобильный клиент
|  MobileClientStandalone        - мобильный клиент (автономный)
|  MobileAppClient               - мобильное приложение (клиент)
|  MobileAppServer               - мобильное приложение (сервер)
|  ThickClientManagedApplication - толстый клиент (управляемое приложение)
|  ThickClientServerManagedApplication - толстый клиент (управляемое, клиент-серверный)
|  ThickClientOrdinaryApplication     - толстый клиент (обычное приложение)
|  ThickClientServerOrdinaryApplication - толстый клиент (обычное, клиент-серверный)
|  DistributiveModules           - поставка модулей без исходных текстов
|  UnreferenceProcedures         - поиск неиспользуемых процедур и функций
|  HandlersExistence             - проверка существования назначенных обработчиков
|  EmptyHandlers                 - поиск пустых обработчиков
|  ExtendedModulesCheck          - расширенная проверка модулей
|  CheckUseModality              - поиск использования модальности
|  CheckUseSynchronousCalls      - поиск использования синхронных вызовов
|  UnsupportedFunctional         - поиск неподдерживаемой функциональности
|  AllExtensions                 - проверка всех расширений")
Перем РежимыПроверки;

&ПараметрИнструмента(Имя = "junitpath", Описание = "Путь к файлу отчёта в формате JUnit XML")
Перем ПутьОтчетаJUnit;

&ПараметрИнструмента(Имя = "exception-file", Описание = "Путь к файлу с пропускаемыми исключениями (UTF-8, по строке на исключение)")
Перем ФайлИсключений;

&ПараметрИнструмента(Имя = "groupbymetadata", Описание = "Группировать ошибки по метаданным конфигурации", Тип = "boolean")
Перем ГруппироватьПоМетаданным;

&ПараметрИнструмента(Имя = "testsuitename", Описание = "Имя тестового набора в отчёте JUnit")
Перем ИмяТестовогоНабора;

&Инструмент(Имя = "validate-syntax-check", Описание = "Проверка синтаксиса конфигурации")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаValidateSyntaxcheck();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Проверка синтаксиса конфигурации выполнена";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисПлатформы", СервисПлатформы);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииСУБД", КонтекстMCP.НаборОпцийСУБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииХранилища", КонтекстMCP.НаборОпцийХранилища());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если РежимыПроверки <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "РежимыПроверки", РежимыПроверки);
	КонецЕсли;

	Если ПутьОтчетаJUnit <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьОтчетаJUnit", ПутьОтчетаJUnit);
	КонецЕсли;

	Если ФайлИсключений <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ФайлИсключений", ФайлИсключений);
	КонецЕсли;

	Если ГруппироватьПоМетаданным <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ГруппироватьПоМетаданным", ГруппироватьПоМетаданным);
	КонецЕсли;

	Если ИмяТестовогоНабора <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ИмяТестовогоНабора", ИмяТестовогоНабора);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
