// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисПлатформы;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&ПараметрИнструмента(Имя = "SRC", Описание = "Каталог XML-исходников расширения или путь к .cfe-файлу")
Перем Источник;

&ПараметрИнструмента(Имя = "extension-name", Описание = "Имя расширения в базе. Если не задано - берётся из имени каталога или файла источника")
Перем ИмяРасширения;

&ПараметрИнструмента(Имя = "safe-mode", Описание = "Включить безопасный режим. Через конфигуратор устанавливается при загрузке; через ibcmd - отдельной командой после загрузки", Тип = "boolean")
Перем БезопасныйРежим;

&ПараметрИнструмента(Имя = "active", Описание = "Активность расширения (только ibcmd)", Тип = "boolean")
Перем Активность;

&ПараметрИнструмента(Имя = "unsafe-action-protection", Описание = "Включить защиту от опасных действий. Через конфигуратор устанавливается при загрузке; через ibcmd - отдельной командой после загрузки", Тип = "boolean")
Перем ЗащитаОтОпасныхДействий;

&ПараметрИнструмента(Имя = "used-in-rib", Описание = "Используется в РИБ (только ibcmd)", Тип = "boolean")
Перем ИспользуетсяВРИБ;

&ПараметрИнструмента(Имя = "scope-infobase", Описание = "Область действия - ИБ, не разделитель данных (только ibcmd)", Тип = "boolean")
Перем ОбластьДействия_ИБ;

&ПараметрИнструмента(Имя = "increment", Описание = "Инкрементальная загрузка по индексу изменений", Тип = "boolean")
Перем Инкремент;

&ПараметрИнструмента(Имя = "no-epf", Описание = "Загружать через конфигуратор без EPF (отключает установку свойств расширения)", Тип = "boolean")
Перем НеИспользоватьЭнтерпрайзРежим;

&ПараметрИнструмента(Имя = "update-db", Описание = "После загрузки обновить конфигурацию БД для расширения (UpdateDBCfg / config apply)", Тип = "boolean")
Перем ОбновитьБД;

&Инструмент(Имя = "cfe-load", Описание = "Загрузить расширение в базу из .cfe-файла или XML-исходников")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаCfeLoad();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Загрузить расширение в базу из .cfe-файла или XML-исходников завершена";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисРасширений", СервисРасширений);
	Рефлектор.УстановитьСвойство(Команда, "СервисПлатформы", СервисПлатформы);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);
	Рефлектор.УстановитьСвойство(Команда, "СервисОкружения", СервисОкружения);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииСУБД", КонтекстMCP.НаборОпцийСУБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииОбновленияБД", КонтекстMCP.НаборОпцийОбновленияБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если Источник <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "Источник", Источник);
	КонецЕсли;

	Если ИмяРасширения <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ИмяРасширения", ИмяРасширения);
	КонецЕсли;

	Если БезопасныйРежим <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "БезопасныйРежим", БезопасныйРежим);
	КонецЕсли;

	Если Активность <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "Активность", Активность);
	КонецЕсли;

	Если ЗащитаОтОпасныхДействий <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ЗащитаОтОпасныхДействий", ЗащитаОтОпасныхДействий);
	КонецЕсли;

	Если ИспользуетсяВРИБ <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ИспользуетсяВРИБ", ИспользуетсяВРИБ);
	КонецЕсли;

	Если ОбластьДействия_ИБ <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ОбластьДействия_ИБ", ОбластьДействия_ИБ);
	КонецЕсли;

	Если Инкремент <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "Инкремент", Инкремент);
	КонецЕсли;

	Если НеИспользоватьЭнтерпрайзРежим <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "НеИспользоватьЭнтерпрайзРежим", НеИспользоватьЭнтерпрайзРежим);
	КонецЕсли;

	Если ОбновитьБД <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ОбновитьБД", ОбновитьБД);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
