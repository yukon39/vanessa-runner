// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисРасширений;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&ПараметрИнструмента(Имя = "OUT", Описание = "Путь к выходному файлу расширения (*.cfe)")
Перем ПутьКФайлуCfe;

&ПараметрИнструмента(Имя = "s src", Описание = "Каталог XML-исходников расширения (по умолчанию - текущий каталог)")
Перем КаталогИсходников;

&ПараметрИнструмента(Имя = "extension-name", Описание = "Имя расширения")
Перем ИмяРасширения;

&Инструмент(Имя = "cfe-compile", Описание = "Собрать расширение из XML-исходников в .cfe-файл")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаCfeCompile();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Собрать расширение из XML-исходников в .cfe-файл выполнена";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисРасширений", СервисРасширений);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);
	Рефлектор.УстановитьСвойство(Команда, "СервисОкружения", СервисОкружения);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииСУБД", КонтекстMCP.НаборОпцийСУБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если ПутьКФайлуCfe <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКФайлуCfe", ПутьКФайлуCfe);
	КонецЕсли;

	Если КаталогИсходников <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "КаталогИсходников", КаталогИсходников);
	КонецЕсли;

	Если ИмяРасширения <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ИмяРасширения", ИмяРасширения);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
