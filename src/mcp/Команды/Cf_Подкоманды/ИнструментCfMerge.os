// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&ПараметрИнструмента(Имя = "src", Описание = "Путь к файлу конфигурации (cf)")
Перем ПутьКCf;

&ПараметрИнструмента(Имя = "merge-settings", Описание = "Путь к файлу настроек объединения")
Перем ФайлНастроек;

&ПараметрИнструмента(Имя = "enable-support", Описание = "Поставить конфигурацию на поддержку", Тип = "boolean")
Перем ВключитьПоддержку;

&ПараметрИнструмента(Имя = "disable-support", Описание = "Снять конфигурацию с поддержки", Тип = "boolean")
Перем ОтключитьПоддержку;

&ПараметрИнструмента(Имя = "IncludeObjectsByUnresolvedRefs", Описание = "Включить объекты с неразрешёнными ссылками в объединение", Тип = "boolean")
Перем IncludeObjectsByUnresolvedRefs;

&ПараметрИнструмента(Имя = "ClearUnresolvedRefs", Описание = "Очищать ссылки на объекты с неразрешёнными ссылками", Тип = "boolean")
Перем ClearUnresolvedRefs;

&ПараметрИнструмента(Имя = "force", Описание = "Принудительное объединение при наличии предупреждений", Тип = "boolean")
Перем Принудительно;

&Инструмент(Имя = "cf-merge", Описание = "Объединить конфигурацию базы с cf-файлом")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаCfMerge();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Объединить конфигурацию базы с cf-файлом выполнена";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисКонфигурации", СервисКонфигурации);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииСУБД", КонтекстMCP.НаборОпцийСУБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если ПутьКCf <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКCf", ПутьКCf);
	КонецЕсли;

	Если ФайлНастроек <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ФайлНастроек", ФайлНастроек);
	КонецЕсли;

	Если ВключитьПоддержку <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ВключитьПоддержку", ВключитьПоддержку);
	КонецЕсли;

	Если ОтключитьПоддержку <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ОтключитьПоддержку", ОтключитьПоддержку);
	КонецЕсли;

	Если IncludeObjectsByUnresolvedRefs <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "IncludeObjectsByUnresolvedRefs", IncludeObjectsByUnresolvedRefs);
	КонецЕсли;

	Если ClearUnresolvedRefs <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ClearUnresolvedRefs", ClearUnresolvedRefs);
	КонецЕсли;

	Если Принудительно <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "Принудительно", Принудительно);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
