// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&Пластилин
Перем СервисКонфигурации;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&ПараметрИнструмента(Имя = "second-cf", Описание = "Путь ко второму cf-файлу (с чем сравниваем)")
Перем ПутьКВторомуCf;

&ПараметрИнструмента(Имя = "first-cf", Описание = "Путь к первому cf-файлу; если не задан - сравнивается конфигурация базы")
Перем ПутьКПервомуCf;

&ПараметрИнструмента(Имя = "report-dir", Описание = "Каталог для сохранения отчёта (по умолчанию - текущий каталог)")
Перем КаталогОтчёта;

&ПараметрИнструмента(Имя = "report-type", Описание = "Тип отчёта")
Перем ТипОтчёта;

&ПараметрИнструмента(Имя = "report-format", Описание = "Формат файла отчёта")
Перем ФорматОтчёта;

&Инструмент(Имя = "cf-compare", Описание = "Сравнить конфигурации и сформировать отчёт")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	Команда = Новый ПодкомандаCfCompare();
	ПрименитьПараметрыККоманде(Команда);
	Команда.ВыполнитьДействие();

	Возврат "Сравнить конфигурации и сформировать отчёт выполнена";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыККоманде(Команда)

	Рефлектор = Новый Рефлектор();

	Рефлектор.УстановитьСвойство(Команда, "Лог", Логирование.ПолучитьЛог("vrunner"));
	Рефлектор.УстановитьСвойство(Команда, "СервисКонфигурации", СервисКонфигурации);
	Рефлектор.УстановитьСвойство(Команда, "СервисЗаполненияПараметров", СервисЗаполненияПараметров);
	Рефлектор.УстановитьСвойство(Команда, "СервисОкружения", СервисОкружения);

	Рефлектор.УстановитьСвойство(Команда, "ОпцииПодключения", КонтекстMCP.НаборОпцийПодключения());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииПлатформы", КонтекстMCP.НаборОпцийПлатформы());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииСУБД", КонтекстMCP.НаборОпцийСУБД());
	Рефлектор.УстановитьСвойство(Команда, "ОпцииНастроек", КонтекстMCP.НаборОпцийНастроек());

	Если ПутьКВторомуCf <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКВторомуCf", ПутьКВторомуCf);
	КонецЕсли;

	Если ПутьКПервомуCf <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ПутьКПервомуCf", ПутьКПервомуCf);
	КонецЕсли;

	Если КаталогОтчёта <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "КаталогОтчёта", КаталогОтчёта);
	КонецЕсли;

	Если ТипОтчёта <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ТипОтчёта", ТипОтчёта);
	КонецЕсли;

	Если ФорматОтчёта <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Команда, "ФорматОтчёта", ФорматОтчёта);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
