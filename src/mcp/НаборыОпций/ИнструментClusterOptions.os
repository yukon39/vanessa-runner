// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&ПараметрИнструмента(Имя = "ras", Описание = "Сетевой адрес RAS (по умолчанию localhost:1545)")
Перем АдресRAS;

&ПараметрИнструмента(Имя = "rac", Описание = "Путь к утилите rac")
Перем ПутьRac;

&ПараметрИнструмента(Имя = "db-name", Описание = "Имя информационной базы в кластере")
Перем ИмяИБ;

&ПараметрИнструмента(Имя = "cluster", Описание = "Идентификатор кластера")
Перем ИдентификаторКластера;

&ПараметрИнструмента(Имя = "cluster-name", Описание = "Имя кластера")
Перем ИмяКластера;

&Инструмент(Имя = "cluster-options", Описание = "Установить опции кластера серверов 1С")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	НаборОпций = КонтекстMCP.НаборОпцийКластера();

	Если АдресRAS <> Неопределено Тогда
		НаборОпций.АдресRAS = АдресRAS;
	КонецЕсли;
	Если ПутьRac <> Неопределено Тогда
		НаборОпций.ПутьRac = ПутьRac;
	КонецЕсли;
	Если ИмяИБ <> Неопределено Тогда
		НаборОпций.ИмяИБ = ИмяИБ;
	КонецЕсли;
	Если ИдентификаторКластера <> Неопределено Тогда
		НаборОпций.ИдентификаторКластера = ИдентификаторКластера;
	КонецЕсли;
	Если ИмяКластера <> Неопределено Тогда
		НаборОпций.ИмяКластера = ИмяКластера;
	КонецЕсли;

	Ответ = Новый Соответствие;
	Если НаборОпций.АдресRAS <> Неопределено Тогда
		Ответ.Вставить("ras", НаборОпций.АдресRAS);
	КонецЕсли;
	Если НаборОпций.ПутьRac <> Неопределено Тогда
		Ответ.Вставить("rac", НаборОпций.ПутьRac);
	КонецЕсли;
	Если НаборОпций.ИмяИБ <> Неопределено Тогда
		Ответ.Вставить("db-name", НаборОпций.ИмяИБ);
	КонецЕсли;
	Если НаборОпций.ИдентификаторКластера <> Неопределено Тогда
		Ответ.Вставить("cluster", НаборОпций.ИдентификаторКластера);
	КонецЕсли;
	Если НаборОпций.ИмяКластера <> Неопределено Тогда
		Ответ.Вставить("cluster-name", НаборОпций.ИмяКластера);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
