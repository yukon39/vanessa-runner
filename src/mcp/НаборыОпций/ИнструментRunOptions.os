// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&ПараметрИнструмента(Имя = "nocacheuse", Описание = "Не использовать кеш платформы", Тип = "boolean")
Перем НеИспользоватьКеш;

&ПараметрИнструмента(Имя = "ordinaryapp", Описание = "Режим запуска клиента. Значения: 1 (толстый), 0 (тонкий), -1 (авто)")
Перем РежимЗапуска;

&ПараметрИнструмента(Имя = "additional", Описание = "Дополнительные параметры запуска платформы")
Перем ДополнительныеПараметры;

&ПараметрИнструмента(Имя = "ibsrv", Описание = "Запускать команду через автономный сервер ibsrv (только для файловых ИБ)", Тип = "boolean")
Перем ИспользоватьIbsrv;

&ПараметрИнструмента(Имя = "ibsrv-direct", Описание = "Использовать прямое соединение с ibsrv (по умолчанию - через WS)", Тип = "boolean")
Перем ИспользоватьПрямоеСоединениеIbsrv;

&ПараметрИнструмента(Имя = "ibsrv-debug", Описание = "Включить порт отладки на запущенном ibsrv", Тип = "boolean")
Перем ИспользоватьОтладкуIbsrv;

&Инструмент(Имя = "run-options", Описание = "Установить опции запуска 1С")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	НаборОпций = КонтекстMCP.НаборОпцийЗапуска();

	Если НеИспользоватьКеш <> Неопределено Тогда
		НаборОпций.НеИспользоватьКеш = НеИспользоватьКеш;
	КонецЕсли;
	Если РежимЗапуска <> Неопределено Тогда
		НаборОпций.РежимЗапуска = РежимЗапуска;
	КонецЕсли;
	Если ДополнительныеПараметры <> Неопределено Тогда
		НаборОпций.ДополнительныеПараметры = ДополнительныеПараметры;
	КонецЕсли;
	Если ИспользоватьIbsrv <> Неопределено Тогда
		НаборОпций.ИспользоватьIbsrv = ИспользоватьIbsrv;
	КонецЕсли;
	Если ИспользоватьПрямоеСоединениеIbsrv <> Неопределено Тогда
		НаборОпций.ИспользоватьПрямоеСоединениеIbsrv = ИспользоватьПрямоеСоединениеIbsrv;
	КонецЕсли;
	Если ИспользоватьОтладкуIbsrv <> Неопределено Тогда
		НаборОпций.ИспользоватьОтладкуIbsrv = ИспользоватьОтладкуIbsrv;
	КонецЕсли;

	Ответ = Новый Соответствие;
	Если НаборОпций.НеИспользоватьКеш <> Неопределено Тогда
		Ответ.Вставить("nocacheuse", НаборОпций.НеИспользоватьКеш);
	КонецЕсли;
	Если НаборОпций.РежимЗапуска <> Неопределено Тогда
		Ответ.Вставить("ordinaryapp", НаборОпций.РежимЗапуска);
	КонецЕсли;
	Если НаборОпций.ДополнительныеПараметры <> Неопределено Тогда
		Ответ.Вставить("additional", НаборОпций.ДополнительныеПараметры);
	КонецЕсли;
	Если НаборОпций.ИспользоватьIbsrv <> Неопределено Тогда
		Ответ.Вставить("ibsrv", НаборОпций.ИспользоватьIbsrv);
	КонецЕсли;
	Если НаборОпций.ИспользоватьПрямоеСоединениеIbsrv <> Неопределено Тогда
		Ответ.Вставить("ibsrv-direct", НаборОпций.ИспользоватьПрямоеСоединениеIbsrv);
	КонецЕсли;
	Если НаборОпций.ИспользоватьОтладкуIbsrv <> Неопределено Тогда
		Ответ.Вставить("ibsrv-debug", НаборОпций.ИспользоватьОтладкуIbsrv);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
