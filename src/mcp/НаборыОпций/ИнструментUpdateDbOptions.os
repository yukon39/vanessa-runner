// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&ПараметрИнструмента(Имя = "rtype", Описание = "Режим реструктуризации БД при обновлении (только конфигуратор). См. https://its.1c.ru/db/v8326doc#bookmark:dev:TI000002111. Значения: v1, v2")
Перем РежимРеструктуризации;

&ПараметрИнструмента(Имя = "dynamic", Описание = "Разрешить динамическое обновление конфигурации БД", Тип = "boolean")
Перем ДинамическоеОбновление;

&Инструмент(Имя = "update-db-options", Описание = "Установить опции обновления конфигурации БД")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	НаборОпций = КонтекстMCP.НаборОпцийОбновленияБД();

	Если РежимРеструктуризации <> Неопределено Тогда
		НаборОпций.РежимРеструктуризации = РежимРеструктуризации;
	КонецЕсли;
	Если ДинамическоеОбновление <> Неопределено Тогда
		НаборОпций.ДинамическоеОбновление = ДинамическоеОбновление;
	КонецЕсли;

	Ответ = Новый Соответствие;
	Если НаборОпций.РежимРеструктуризации <> Неопределено Тогда
		Ответ.Вставить("rtype", НаборОпций.РежимРеструктуризации);
	КонецЕсли;
	Если НаборОпций.ДинамическоеОбновление <> Неопределено Тогда
		Ответ.Вставить("dynamic", НаборОпций.ДинамическоеОбновление);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
