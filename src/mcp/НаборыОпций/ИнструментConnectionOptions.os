// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&ПараметрИнструмента(Имя = "ibconnection", Описание = "Строка подключения к информационной базе (/F или /S)")
Перем СтрокаПодключения;

&ПараметрИнструмента(Имя = "db-user", Описание = "Имя пользователя информационной базы")
Перем Пользователь;

&ПараметрИнструмента(Имя = "db-pwd", Описание = "Пароль пользователя информационной базы")
Перем Пароль;

&ПараметрИнструмента(Имя = "ibcmd", Описание = "Использовать утилиту ibcmd вместо конфигуратора", Тип = "boolean")
Перем ИспользоватьIbcmd;

&Инструмент(Имя = "connection-options", Описание = "Установить опции подключения к информационной базе")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	НаборОпций = КонтекстMCP.НаборОпцийПодключения();

	Если СтрокаПодключения <> Неопределено Тогда
		НаборОпций.СтрокаПодключения = СтрокаПодключения;
	КонецЕсли;
	Если Пользователь <> Неопределено Тогда
		НаборОпций.Пользователь = Пользователь;
	КонецЕсли;
	Если Пароль <> Неопределено Тогда
		НаборОпций.Пароль = Пароль;
	КонецЕсли;
	Если ИспользоватьIbcmd <> Неопределено Тогда
		НаборОпций.ИспользоватьIbcmd = ИспользоватьIbcmd;
	КонецЕсли;

	Ответ = Новый Соответствие;
	Если НаборОпций.СтрокаПодключения <> Неопределено Тогда
		Ответ.Вставить("ibconnection", НаборОпций.СтрокаПодключения);
	КонецЕсли;
	Если НаборОпций.Пользователь <> Неопределено Тогда
		Ответ.Вставить("db-user", "********");
	КонецЕсли;
	Если НаборОпций.Пароль <> Неопределено Тогда
		Ответ.Вставить("db-pwd", "********");
	КонецЕсли;
	Если НаборОпций.ИспользоватьIbcmd <> Неопределено Тогда
		Ответ.Вставить("ibcmd", НаборОпций.ИспользоватьIbcmd);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
