// BSLLS:MissingVariablesDescription-off Поля &ПараметрИнструмента - описания заданы в аннотациях.

&Пластилин("КонтекстВанессаMCP")
Перем КонтекстMCP;

&ПараметрИнструмента(Имя = "v8version", Описание = "Версия платформы 1С")
Перем ВерсияПлатформы;

&ПараметрИнструмента(Имя = "uccode", Описание = "Код разрешения")
Перем КодРазрешения;

&ПараметрИнструмента(Имя = "language", Описание = "Язык платформы")
Перем Язык;

&ПараметрИнструмента(Имя = "locale", Описание = "Язык сеанса (локаль)")
Перем Локаль;

&Инструмент(Имя = "platform-options", Описание = "Установить опции платформы 1С")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнениеИнструмента() Экспорт

	НаборОпций = КонтекстMCP.НаборОпцийПлатформы();

	Если ВерсияПлатформы <> Неопределено Тогда
		НаборОпций.ВерсияПлатформы = ВерсияПлатформы;
	КонецЕсли;
	Если КодРазрешения <> Неопределено Тогда
		НаборОпций.КодРазрешения = КодРазрешения;
	КонецЕсли;
	Если Язык <> Неопределено Тогда
		НаборОпций.Язык = Язык;
	КонецЕсли;
	Если Локаль <> Неопределено Тогда
		НаборОпций.Локаль = Локаль;
	КонецЕсли;

	Ответ = Новый Соответствие;
	Если НаборОпций.ВерсияПлатформы <> Неопределено Тогда
		Ответ.Вставить("v8version", НаборОпций.ВерсияПлатформы);
	КонецЕсли;
	Если НаборОпций.КодРазрешения <> Неопределено Тогда
		Ответ.Вставить("uccode", НаборОпций.КодРазрешения);
	КонецЕсли;
	Если НаборОпций.Язык <> Неопределено Тогда
		Ответ.Вставить("language", НаборОпций.Язык);
	КонецЕсли;
	Если НаборОпций.Локаль <> Неопределено Тогда
		Ответ.Вставить("locale", НаборОпций.Локаль);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
